# ==============================================================================
# AI Project Planner - Environment Variables Configuration
# ==============================================================================
# Salin file ini menjadi .env.local untuk environment lokal:
#   cp .env.local.example .env.local
#
# Untuk deployment Vercel:
# Masukkan seluruh variabel di bawah ini ke menu:
#   Project Settings -> Environment Variables pada dashboard Vercel.
# ==============================================================================

# 1. DATABASE (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string PostgreSQL dari Supabase (Project Settings -> Database).
# CATATAN UNTUK VERCEL / SERVERLESS:
# Sangat direkomendasikan menggunakan Transaction Pooler (port 6543) dengan pgbouncer:
#   Contoh: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Untuk koneksi langsung/session pooler:
#   Contoh: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=

# 2. NEXTAUTH / AUTH.JS (v5)
# ------------------------------------------------------------------------------
# Secret key enkripsi token sesi JWT.
# Generate string acak dengan perintah terminal: openssl rand -base64 32
NEXTAUTH_SECRET=
AUTH_SECRET=

# URL dasar aplikasi:
# - Lokal: http://localhost:3000
# - Produksi (Vercel): https://<project-name>.vercel.app (atau custom domain Anda)
NEXTAUTH_URL=http://localhost:3000

# Diperlukan untuk deployment di balik reverse proxy / serverless (Vercel):
AUTH_TRUST_HOST=true

# 3. GOOGLE OAUTH PROVIDER
# ------------------------------------------------------------------------------
# Dapatkan dari Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Client IDs).
# Authorized JavaScript Origins:
#   - http://localhost:3000
#   - https://<project-name>.vercel.app
# Authorized Redirect URIs:
#   - http://localhost:3000/api/auth/callback/google
#   - https://<project-name>.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 4. OPENROUTER AI API
# ------------------------------------------------------------------------------
# API Key OpenRouter untuk mengakses model DeepSeek (dan model AI lainnya).
# Dapatkan di: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 5. GOOGLE GEMINI AI API
# ------------------------------------------------------------------------------
# API Key Google Gemini untuk mengakses model Gemini resmi (Google AI Studio).
# Dapatkan di Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

